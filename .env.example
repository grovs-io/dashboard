# ===========================================
# Grovs Web App - Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# -------------------------------------------
# Core API
# Runtime value: change it when starting the server or container; no rebuild needed.
# -------------------------------------------
API_URL=https://your-api-url.com
NEXT_PUBLIC_API_PATH=/api/v1
NEXT_PUBLIC_ENV=test

# -------------------------------------------
# OAuth Credentials
# -------------------------------------------
NEXT_PUBLIC_CLIENT_ID=your-client-id

# Server-only secret (never exposed to browser)
CLIENT_SECRET=your-client-secret

# -------------------------------------------
# Chatwoot Live Chat (optional)
# Omit these to disable live chat.
# -------------------------------------------
NEXT_PUBLIC_CHATWOOT_URL=
NEXT_PUBLIC_CHATWOOT_TOKEN=

# -------------------------------------------
# Firebase (optional — hosting & analytics only)
# -------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -------------------------------------------
# Enterprise Edition (optional)
# Set to "true" to enable revenue tracking features
# -------------------------------------------
# NEXT_PUBLIC_GROVS_EE=true

# -------------------------------------------
# Self-hosted build (optional)
# Set to "true" to hide SaaS-only UI such as public sign-up and Stripe billing.
# The login page discovers enabled Google/Microsoft SSO providers from the
# backend; provider client secrets remain backend-only.
# Onboard via the bootstrap admin, configured SSO, and invite links.
# -------------------------------------------
# NEXT_PUBLIC_SELF_HOSTED=true

# -------------------------------------------
# Analytics (optional)
# PostHog requires KEY (HOST is optional and defaults to eu.i.posthog.com).
# GTM requires GTM_ID. Empty required variables disable the integration.
# Chatwoot alone is always disabled when NEXT_PUBLIC_SELF_HOSTED=true.
# -------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GTM_ID=
